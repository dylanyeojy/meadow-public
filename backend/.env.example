# Copy to .env and fill in. Never commit .env.

# From the Supabase dashboard, Project Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses row-level security. Used for account deletion only.
SUPABASE_SERVICE_ROLE_KEY=

# Where the classifier service is listening.
CLASSIFIER_URL=http://127.0.0.1:8001
